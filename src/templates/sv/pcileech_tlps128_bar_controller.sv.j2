{{ header }}
//
// PCILeech FPGA - Device-Aware BAR Controller
//
// Auto-generated BAR controller with device-specific implementation.
// This file integrates the learned BAR behavior from {{ device_signature }}.
//
// Based on PCILeech FPGA BAR PIO controller by Ulf Frisk
// Modified to use device-specific BAR implementation when available.
//

`timescale 1ns / 1ps
`include "pcileech_header.svh"
{% from "sv/msix/_msix_subsystem.j2" import msix_subsystem %}

module pcileech_tlps128_bar_controller(
    input                   rst,
    input                   clk,
    input                   bar_en,
    input [15:0]            pcie_id,
    IfPCIeSignals.mpro      pcie_ctx,       // read-only PCIe core status (clk domain)
    input                   rst_pcie_user,  // PCIe core user reset: PERST, link down
    IfAXIS128.sink_lite     tlps_in,
    IfAXIS128.source        tlps_out
);
{% set _msix = msix_rtl if (msix_rtl is defined and msix_rtl) else none %}
    
    // ------------------------------------------------------------------------
    // 1: TLP RECEIVE:
    // Receive incoming BAR requests from the TLP stream:
    // send them onwards to read and write FIFOs
    // ------------------------------------------------------------------------
    wire in_is_wr_ready;
    bit  in_is_wr_last;
    wire in_is_first    = tlps_in.tuser[0];
    wire in_is_bar      = bar_en && (tlps_in.tuser[8:2] != 0);
    wire in_is_rd       = (in_is_first && tlps_in.tlast && ((tlps_in.tdata[31:25] == 7'b0000000) || (tlps_in.tdata[31:25] == 7'b0010000) || (tlps_in.tdata[31:24] == 8'b00000010)));
    wire in_is_wr       = in_is_wr_last || (in_is_first && in_is_wr_ready && ((tlps_in.tdata[31:25] == 7'b0100000) || (tlps_in.tdata[31:25] == 7'b0110000) || (tlps_in.tdata[31:24] == 8'b01000010)));
    
    always @ ( posedge clk )
        if ( rst ) begin
            in_is_wr_last <= 0;
        end
        else if ( tlps_in.tvalid ) begin
            in_is_wr_last <= !tlps_in.tlast && in_is_wr;
        end
    
    wire [6:0]  wr_bar;
    wire [31:0] wr_addr;
    wire [3:0]  wr_be;
    wire [31:0] wr_data;
    wire        wr_valid;
    wire [87:0] rd_req_ctx;
    wire [6:0]  rd_req_bar;
    wire [31:0] rd_req_addr;
    wire        rd_req_valid;
    wire [87:0] rd_rsp_ctx;
    wire [31:0] rd_rsp_data;
    wire        rd_rsp_valid;
{% if _msix %}

    // BAR completions go through the MSI-X transmit merger (below) on their
    // way to tlps_out.
    IfAXIS128 tlps_bar_cpl();
{% endif %}
        
    pcileech_tlps128_bar_rdengine i_pcileech_tlps128_bar_rdengine(
        .rst            ( rst                           ),
        .clk            ( clk                           ),
        // TLPs:
        .pcie_id        ( pcie_id                       ),
        .tlps_in        ( tlps_in                       ),
        .tlps_in_valid  ( tlps_in.tvalid && in_is_bar && in_is_rd ),
        .tlps_out       ( {{ 'tlps_bar_cpl.source' if _msix else 'tlps_out' }}{{ ' ' * (31 - ('tlps_bar_cpl.source' if _msix else 'tlps_out')|length) }}),
        // BAR reads:
        .rd_req_ctx     ( rd_req_ctx                    ),
        .rd_req_bar     ( rd_req_bar                    ),
        .rd_req_addr    ( rd_req_addr                   ),
        .rd_req_valid   ( rd_req_valid                  ),
        .rd_rsp_ctx     ( rd_rsp_ctx                    ),
        .rd_rsp_data    ( rd_rsp_data                   ),
        .rd_rsp_valid   ( rd_rsp_valid                  )
    );

    pcileech_tlps128_bar_wrengine i_pcileech_tlps128_bar_wrengine(
        .rst            ( rst                           ),
        .clk            ( clk                           ),
        // TLPs:
        .tlps_in        ( tlps_in                       ),
        .tlps_in_valid  ( tlps_in.tvalid && in_is_bar && in_is_wr ),
        .tlps_in_ready  ( in_is_wr_ready                ),
        // outgoing BAR writes:
        .wr_bar         ( wr_bar                        ),
        .wr_addr        ( wr_addr                       ),
        .wr_be          ( wr_be                         ),
        .wr_data        ( wr_data                       ),
        .wr_valid       ( wr_valid                      )
    );
    
    wire [87:0] bar_rsp_ctx[7];
    wire [31:0] bar_rsp_data[7];
    wire        bar_rsp_valid[7];
    
{% if timing_config is defined and timing_config and timing_config.get('enable_latency_jitter', False) %}
    // ========================================================================
    // TLP Latency Emulation (enabled via behavior profiling)
    // SECURITY: All timing parameters must come from device profiling
    // ========================================================================
    {%- if not timing_config.get('min_read_latency') %}
    {% error "timing_config.min_read_latency must be provided from device profiling" %}
    {%- endif %}
    {%- if not timing_config.get('max_read_latency') %}
    {% error "timing_config.max_read_latency must be provided from device profiling" %}
    {%- endif %}
    {%- if not timing_config.get('avg_read_latency') %}
    {% error "timing_config.avg_read_latency must be provided from device profiling" %}
    {%- endif %}
    wire [87:0] bar_latency_rsp_ctx[7];
    wire [31:0] bar_latency_rsp_data[7];
    wire        bar_latency_rsp_valid[7];
    
    genvar bar_idx;
    generate
        for (bar_idx = 0; bar_idx < 7; bar_idx = bar_idx + 1) begin : gen_latency_emulators
            tlp_latency_emulator #(
                .MIN_LATENCY_CYCLES({{ timing_config.get('min_read_latency') }}),
                .MAX_LATENCY_CYCLES({{ timing_config.get('max_read_latency') }}),
                .AVG_LATENCY_CYCLES({{ timing_config.get('avg_read_latency') }}),
                .ENABLE_JITTER(1'b1)
            ) i_tlp_latency_emulator (
                .rst            ( rst                               ),
                .clk            ( clk                               ),
                .req_ctx        ( bar_rsp_ctx[bar_idx]              ),
                .req_data       ( bar_rsp_data[bar_idx]             ),
                .req_valid      ( bar_rsp_valid[bar_idx]            ),
                .rsp_ctx        ( bar_latency_rsp_ctx[bar_idx]      ),
                .rsp_data       ( bar_latency_rsp_data[bar_idx]     ),
                .rsp_valid      ( bar_latency_rsp_valid[bar_idx]    )
            );
        end
    endgenerate
    
    assign rd_rsp_ctx = bar_latency_rsp_valid[0] ? bar_latency_rsp_ctx[0] :
                        bar_latency_rsp_valid[1] ? bar_latency_rsp_ctx[1] :
                        bar_latency_rsp_valid[2] ? bar_latency_rsp_ctx[2] :
                        bar_latency_rsp_valid[3] ? bar_latency_rsp_ctx[3] :
                        bar_latency_rsp_valid[4] ? bar_latency_rsp_ctx[4] :
                        bar_latency_rsp_valid[5] ? bar_latency_rsp_ctx[5] :
                        bar_latency_rsp_valid[6] ? bar_latency_rsp_ctx[6] : 0;
    assign rd_rsp_data = bar_latency_rsp_valid[0] ? bar_latency_rsp_data[0] :
                        bar_latency_rsp_valid[1] ? bar_latency_rsp_data[1] :
                        bar_latency_rsp_valid[2] ? bar_latency_rsp_data[2] :
                        bar_latency_rsp_valid[3] ? bar_latency_rsp_data[3] :
                        bar_latency_rsp_valid[4] ? bar_latency_rsp_data[4] :
                        bar_latency_rsp_valid[5] ? bar_latency_rsp_data[5] :
                        bar_latency_rsp_valid[6] ? bar_latency_rsp_data[6] : 0;
    assign rd_rsp_valid = bar_latency_rsp_valid[0] || bar_latency_rsp_valid[1] || bar_latency_rsp_valid[2] || bar_latency_rsp_valid[3] || bar_latency_rsp_valid[4] || bar_latency_rsp_valid[5] || bar_latency_rsp_valid[6];
{% else %}
    // Direct connection (no latency emulation)
    assign rd_rsp_ctx = bar_rsp_valid[0] ? bar_rsp_ctx[0] :
                        bar_rsp_valid[1] ? bar_rsp_ctx[1] :
                        bar_rsp_valid[2] ? bar_rsp_ctx[2] :
                        bar_rsp_valid[3] ? bar_rsp_ctx[3] :
                        bar_rsp_valid[4] ? bar_rsp_ctx[4] :
                        bar_rsp_valid[5] ? bar_rsp_ctx[5] :
                        bar_rsp_valid[6] ? bar_rsp_ctx[6] : 0;
    assign rd_rsp_data = bar_rsp_valid[0] ? bar_rsp_data[0] :
                        bar_rsp_valid[1] ? bar_rsp_data[1] :
                        bar_rsp_valid[2] ? bar_rsp_data[2] :
                        bar_rsp_valid[3] ? bar_rsp_data[3] :
                        bar_rsp_valid[4] ? bar_rsp_data[4] :
                        bar_rsp_valid[5] ? bar_rsp_data[5] :
                        bar_rsp_valid[6] ? bar_rsp_data[6] : 0;
    assign rd_rsp_valid = bar_rsp_valid[0] || bar_rsp_valid[1] || bar_rsp_valid[2] || bar_rsp_valid[3] || bar_rsp_valid[4] || bar_rsp_valid[5] || bar_rsp_valid[6];
{% endif %}
    
{#
    Gap C — donor-BAR-index serving. The donor's primary register window is
    served at its REAL PCI BAR index (served_bar_index); every other slot is a
    non-responding stub (pcileech_bar_impl_none), with loopaddr kept at slot 1
    when free for test/diagnostics. A 64-bit served BAR lights two adjacent hit
    bits (N and N+1), so slot N+1 MUST be `none` — never loopaddr — or the
    response mux would be double-driven. When served_bar_index == 0 and 32-bit
    this reproduces the historical wiring (device@0, loopaddr@1, none@2..6).
#}
{% if device_bar_served_index is defined %}
{% set _served = device_bar_served_index %}
{% else %}
{% set _served = ((bar_config.served_bar_index | default(0)) if bar_config else 0) | int %}
{% endif %}
{% set _served64 = (bar_config.served_is_64bit | default(false)) if bar_config else false %}
{# The device implementation is used only when the served BAR itself has a
   non-empty learned model. SVOverlayGenerator computes that once and passes
   device_bar_impl_selected so this template and the generated implementation
   cannot disagree. The fallback (direct renders only) counts registers rather
   than relying on object truthiness: TemplateObject is always truthy. #}
{% if device_bar_impl_selected is defined %}
{% set _has_model = device_bar_impl_selected %}
{% else %}
{% set _models = (bar_config.get('bar_models') if bar_config else none) or {} %}
{% set _served_model = _models.get(_served) or _models.get(_served | string) %}
{% set _regs = (_served_model.get('regs') or _served_model.get('registers')) if _served_model else none %}
{% set _has_model = (_regs.keys() | list | length > 0) if _regs else false %}
{% endif %}
{% set _bar_size = (bar_config.aperture_size | default(4096)) if bar_config else 4096 %}
{% macro bar_inst(module, k, inst, param_size=None, wr_valid=None, rd_valid=None, rsp=None) -%}
{% set _wr_valid = wr_valid or ('wr_valid && wr_bar[' ~ k ~ ']') %}
{% set _rd_valid = rd_valid or ('rd_req_valid && rd_req_bar[' ~ k ~ ']') %}
{% set _rsp = rsp or ['bar_rsp_ctx[' ~ k ~ ']', 'bar_rsp_data[' ~ k ~ ']', 'bar_rsp_valid[' ~ k ~ ']'] %}
{% if param_size is not none %}    {{ module }} #(
        .BAR_SIZE       ( {{ param_size }} )
    ) {{ inst }}(
{% else %}    {{ module }} {{ inst }}(
{% endif %}        .rst            ( rst                           ),
        .clk            ( clk                           ),
        .wr_addr        ( wr_addr                       ),
        .wr_be          ( wr_be                         ),
        .wr_data        ( wr_data                       ),
        .wr_valid       ( {{ _wr_valid }} ),
        .rd_req_ctx     ( rd_req_ctx                    ),
        .rd_req_addr    ( rd_req_addr                   ),
        .rd_req_valid   ( {{ _rd_valid }} ),
        .rd_rsp_ctx     ( {{ _rsp[0] }} ),
        .rd_rsp_data    ( {{ _rsp[1] }} ),
        .rd_rsp_valid   ( {{ _rsp[2] }} )
    );
{%- endmacro %}
    // ========================================================================
    // BAR implementations (served register window at BAR index {{ _served }})
    // ========================================================================
{% if device_bar_slots is defined %}
{% if _msix and ((_msix.bar_index | string) not in device_bar_slots or device_bar_slots.get(_msix.bar_index | string).size != _msix.bar_size) %}
{% error "MSI-X layout disagrees with its served BAR descriptor" %}
{% endif %}
{% set _upper_slots = [] %}
{% for slot in device_bar_slots.values() %}
{% if slot.is_64bit %}{% set ignored = _upper_slots.append(slot.index + 1) %}{% endif %}
{% endfor %}
{% for k in range(7) %}
{% set _slot = device_bar_slots.get(k | string) %}
{% if _slot %}
{% set _owns_msix = _msix and _msix.bar_index == k %}
{% if _owns_msix %}{{ msix_subsystem(_msix, k) }}{% endif %}
{% set _slot_inner = dict(wr_valid='msix_inner_wr_valid', rd_valid='msix_inner_rd_req_valid',
                         rsp=['msix_inner_rd_rsp_ctx', 'msix_inner_rd_rsp_data', 'msix_inner_rd_rsp_valid']) if _owns_msix else {} %}
{{ bar_inst(_slot.module, k, 'i_bar' ~ k, param_size=_slot.size if _slot.has_model else none, **_slot_inner) }}
{% elif k == 1 and k not in _upper_slots %}
{{ bar_inst('pcileech_bar_impl_loopaddr', k, 'i_bar' ~ k) }}
{% else %}
{{ bar_inst('pcileech_bar_impl_none', k, 'i_bar' ~ k) }}
{% endif %}
{% endfor %}
{% else %}
{% if _msix and (_msix.bar_index != _served or _msix.bar_size != _bar_size) %}
{% error "MSI-X layout BAR" ~ _msix.bar_index ~ " does not match the served BAR" ~ _served %}
{% endif %}
{% set _inner = dict(wr_valid='msix_inner_wr_valid', rd_valid='msix_inner_rd_req_valid',
                     rsp=['msix_inner_rd_rsp_ctx', 'msix_inner_rd_rsp_data', 'msix_inner_rd_rsp_valid']) if _msix else {} %}
{% for k in range(7) %}
{% if k == _served %}
{% if _msix %}
{{ msix_subsystem(_msix, k) }}
{% endif %}
{% if _has_model %}
{{ bar_inst('pcileech_bar_impl_device', k, 'i_bar' ~ k, param_size=_bar_size, **_inner) }}
{% else %}
{{ bar_inst('pcileech_bar_impl_zerowrite4k', k, 'i_bar' ~ k, **_inner) }}
{% endif %}
{% elif _served64 and k == _served + 1 %}
{{ bar_inst('pcileech_bar_impl_none', k, 'i_bar' ~ k) }}
{% elif k == 1 %}
{{ bar_inst('pcileech_bar_impl_loopaddr', k, 'i_bar' ~ k) }}
{% elif k == 6 %}
{{ bar_inst('pcileech_bar_impl_none', k, 'i_bar6_optrom') }}
{% else %}
{{ bar_inst('pcileech_bar_impl_none', k, 'i_bar' ~ k) }}
{% endif %}
{% endfor %}
{% endif %}


endmodule

// NOTE: The read/write engine implementations and BAR implementation modules
// (pcileech_bar_impl_*) are not included in this template.
// They should be sourced from the upstream pcileech-fpga repository or
// generated as separate modules (e.g., pcileech_bar_impl_device.sv).
