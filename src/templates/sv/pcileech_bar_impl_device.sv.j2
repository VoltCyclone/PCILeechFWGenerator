{# Validate before formatting any value or emitting storage. #}
{% set readonly_fallback = bar_model_readonly_fallback | default(false) %}
{% if not bar_model %}
{{ throw_error('Device BAR implementation requires a nonempty learned register model or the read-only fallback') }}
{% endif %}
{% if not bar_model.registers and not readonly_fallback %}
{{ throw_error('Device BAR implementation requires a nonempty learned register model or the read-only fallback') }}
{% endif %}
{# Context compatibility may stringify integer dictionary keys. #}
{% set registers = {} %}
{% for offset, reg in bar_model.registers.items() %}
{% if int(offset) in registers %}{{ throw_error('Duplicate BAR register offset') }}{% endif %}
{% set ignored = registers.update({int(offset): reg}) %}
{% endfor %}
{% set layout = namespace(end=0, dwords={}) %}
{% for offset, reg in registers.items() | sort %}
{% if reg.reset is none %}
{{ throw_error('BAR register 0x%X has no initial value: %s' % (offset, reg.hints.get('initial_value_absent_reason', 'reason missing'))) }}
{% endif %}
{% if reg.width not in [1, 2, 4] or offset < 0 or offset % reg.width or offset < layout.end or offset + reg.width > bar_model.size %}
{{ throw_error('Invalid or overlapping BAR register layout at 0x%X' % offset) }}
{% endif %}
{% set full_mask = 2 ** (reg.width * 8) - 1 %}
{% if reg.reset < 0 or reg.reset > full_mask or reg.rw_mask < 0 or reg.rw_mask > full_mask %}
{{ throw_error('BAR register value or mask exceeds width at 0x%X' % offset) }}
{% endif %}
{% set layout.end = offset + reg.width %}
{% set ignored = layout.dwords.setdefault((offset // 4) * 4, []).append((offset, reg)) %}
{% endfor %}
{{ header | default('') }}
//
// Device-Specific PCILeech BAR Storage Implementation
// Auto-generated for {{ device_signature }}.
{% if readonly_fallback %}
// READ-ONLY FALLBACK: no learned register model exists for this BAR. Every read
// returns zero and every write is ignored across the whole aperture. This is
// not donor behavior; it claims nothing the evidence does not show.
{% endif %}
// Plain RW masks grant storage updates only. Other semantics are unsupported.
// Unmapped read lanes return zero as an approximation, not a donor measurement.
// Register Map Summary:
{% for offset, reg in registers.items() | sort %}
{% set evidence = reg.hints.get('evidence') or {} %}
{% set source = evidence.get('initial_value_source') or 'legacy_unverified' %}
{% set provenance = 'legacy_unverified' if 'maybe_rw1c' in reg.hints or not evidence.get('classifications') else 'evidence_backed' %}
//   0x{{ '%04X' % offset }}: {{ 'DWORD' if reg.width == 4 else ('WORD' if reg.width == 2 else 'BYTE') }} {{ 'RW' if reg.rw_mask else 'RO storage' }} (initial=0x{{ '%0*X' % (reg.width * 2, reg.reset) }}, source={{ source | replace('\n', ' ') | replace('\r', ' ') | replace('\\', '/') }}, unknown_mask=0x{{ '%0*X' % (reg.width * 2, reg.hints.get('unknown_mask', 2 ** (reg.width * 8) - 1)) }}, provenance={{ provenance }})
{% endfor %}
// FPGA reset initializes storage from the recorded initial value; it does not
// establish the donor's reset behavior. Unsupported actions are not emulated.

`timescale 1ns / 1ps

module {{ device_bar_impl_module | default('pcileech_bar_impl_device') }} #(
    parameter BAR_SIZE = {{ bar_model.size }}
)(
    input               rst,
    input               clk,
    input [31:0]        wr_addr,
    input [31:0]        wr_data,
    input [3:0]         wr_be,
    input               wr_valid,
    input [87:0]        rd_req_ctx,
    input [31:0]        rd_req_addr,
    input               rd_req_valid,
    output reg [87:0]   rd_rsp_ctx,
    output reg [31:0]   rd_rsp_data,
    output reg          rd_rsp_valid
    {% if interrupt_config and interrupt_config.strategy in ['msi', 'msix'] %}
    , output wire       interrupt_assert
    , output wire [7:0] interrupt_data
    {% endif %}
);
    // The controller passes host addresses (TLP address / upper request bits),
    // not BAR offsets. Decode only the offset within this power-of-two BAR.
    {% set bar_size = bar_model.size | int %}
    {% set pow2 = namespace(ok=false) %}
    {% for bit in range(2, 33) %}{% if 2 ** bit == bar_size %}{% set pow2.ok = true %}{% endif %}{% endfor %}
    {% if not pow2.ok %}{{ throw_error('BAR size 0x%X is not a power of two between 4 bytes and 4 GiB' % bar_size) }}{% endif %}
    localparam [31:0] OFFSET_MASK = 32'h{{ '%08X' % (((bar_size - 1) // 4) * 4) }};
    wire [31:0] wr_offset = wr_addr & OFFSET_MASK;
    wire [31:0] rd_offset = rd_req_addr & OFFSET_MASK;

    {% for offset, reg in registers.items() | sort %}
    reg [{{ reg.width * 8 - 1 }}:0] reg_0x{{ '%04X' % offset }};
    {% endfor %}

    // Reset and plain storage writes have one owner. Each DWORD is decoded once.
    always @(posedge clk) begin
        if (rst) begin
            {% for offset, reg in registers.items() | sort %}
            reg_0x{{ '%04X' % offset }} <= {{ reg.width * 8 }}'h{{ '%0*X' % (reg.width * 2, reg.reset) }};
            {% endfor %}
        end
        else if (wr_valid) begin
            case (wr_offset)
                {% for aligned_offset, regs in layout.dwords.items() | sort %}
                {% set writable = namespace(any=false) %}
                {% for offset, reg in regs %}
                {% if reg.rw_mask %}{% set writable.any = true %}{% endif %}
                {% endfor %}
                {% if writable.any %}
                32'h{{ '%08X' % aligned_offset }}: begin
                    {% for offset, reg in regs %}
                    {% set reg_name = 'reg_0x%04X' % offset %}
                    {% for byte in range(reg.width) %}
                    {% set mask = (reg.rw_mask // (2 ** (8 * byte))) % 256 %}
                    {% set lane = offset % 4 + byte %}
                    {% if mask %}
                    if (wr_be[{{ lane }}]) {{ reg_name }}[{{ byte * 8 + 7 }}:{{ byte * 8 }}] <= ({{ reg_name }}[{{ byte * 8 + 7 }}:{{ byte * 8 }}] & ~8'h{{ '%02X' % mask }}) | (wr_data[{{ lane * 8 + 7 }}:{{ lane * 8 }}] & 8'h{{ '%02X' % mask }});
                    {% endif %}
                    {% endfor %}
                    {% endfor %}
                end
                {% endif %}
                {% endfor %}
                default: begin
                    // Unregistered writes have no effect.
                end
            endcase
        end
    end

    // Two-cycle read response, composing all registers sharing a DWORD.
    reg [87:0] rd_req_ctx_d1;
    reg        rd_req_valid_d1;
    reg [31:0] rd_data_d1;

    always @(posedge clk) begin
        if (rst) begin
            rd_req_ctx_d1 <= 88'd0;
            rd_req_valid_d1 <= 1'b0;
            rd_data_d1 <= 32'd0;
        end
        else begin
            rd_req_ctx_d1 <= rd_req_ctx;
            rd_req_valid_d1 <= rd_req_valid;
            rd_data_d1 <= 32'd0;
            if (rd_req_valid) begin
                case (rd_offset)
                    {% for aligned_offset, regs in layout.dwords.items() | sort %}
                    32'h{{ '%08X' % aligned_offset }}: begin
                        {% for offset, reg in regs %}
                        rd_data_d1[{{ (offset % 4 + reg.width) * 8 - 1 }}:{{ (offset % 4) * 8 }}] <= reg_0x{{ '%04X' % offset }};
                        {% endfor %}
                    end
                    {% endfor %}
                    default: begin
                        // Unmapped reads return zero; no semantics are inferred.
                    end
                endcase
            end
        end
    end

    always @(posedge clk) begin
        if (rst) begin
            rd_rsp_ctx <= 88'd0;
            rd_rsp_valid <= 1'b0;
            rd_rsp_data <= 32'd0;
        end
        else begin
            rd_rsp_ctx <= rd_req_ctx_d1;
            rd_rsp_valid <= rd_req_valid_d1;
            rd_rsp_data <= rd_data_d1;
        end
    end

    {% if interrupt_config and interrupt_config.strategy in ['msi', 'msix'] %}
    // No supported device interrupt contract: keep the optional outputs inactive.
    assign interrupt_assert = 1'b0;
    assign interrupt_data = 8'h00;
    {% endif %}
endmodule
